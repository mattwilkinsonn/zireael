{
	"name": "akiflow-cli",
	"version": "0.3.5",
	"description": "Akiflow CLI - Task management from the command line",
	"author": "YeonGyu Kim <code.yeongyu@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mattwilkinsonn/zireael.git",
		"directory": "tools/akiflow-cli"
	},
	"homepage": "https://github.com/mattwilkinsonn/zireael/tree/main/tools/akiflow-cli",
	"bugs": {
		"url": "https://github.com/mattwilkinsonn/zireael/issues"
	},
	"keywords": [
		"akiflow",
		"cli",
		"task",
		"productivity",
		"todo",
		"bun"
	],
	"module": "src/index.ts",
	"type": "module",
	"bin": {
		"af": "./src/index.ts"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/bun": "^1.3.8"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"chrono-node": "^2.9.0",
		"citty": "^0.2.0",
		"rrule": "^2.8.1"
	},
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
		"build": "bun build src/index.ts --compile --outfile af",
		"build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64",
		"build:darwin-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/af-darwin-arm64",
		"build:darwin-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/af-darwin-x64",
		"build:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/af-linux-x64",
		"build:linux-arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/af-linux-arm64",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun test --test-name-pattern='^(?!.*BDD).*$' src/__tests__/api src/__tests__/auth src/__tests__/commands src/__tests__/lib src/__tests__/setup.test.ts",
		"test:integration": "bun test src/__tests__/integration",
		"lint": "bunx biome check --reporter=summary .",
		"format": "bunx biome check --write .",
		"typecheck": "bunx tsc --noEmit",
		"prepublishOnly": "echo 'This package requires Bun runtime. Install with: bun install -g akiflow-cli'"
	}
}
