amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

// Git hooks managed by hk (https://hk.jdx.dev).
//
// Installed on devenv shell entry (`hk install`, idempotent) — the whole
// fresh-clone bootstrap is `direnv allow`.
//
// The pre-push gate is a thin shell over the local CI command: `moon ci`
// runs every affected runInCI moon task (rust fmt/clippy/nextest, biome +
// tsc + bun test, the nix linters + per-host flake-eval, markdownlint +
// actionlint, brew style). moon's affected detection scopes to the diff
// and its cache skips unchanged tasks, so a focused push runs a focused
// gate. This is the same command CI runs (.github/workflows/ci.yml).
//
// Bypass knobs:
//   HK=0 git push           // skip all hooks (emergency)
//   git push --no-verify    // hk respects this too

// Pin the default-branch reference so hk's affected-diff base resolves on
// fresh clones and in CI (where refs/remotes/origin/HEAD isn't always set).
default_branch = "main"

hooks {
    ["pre-push"] {
        steps {
            // The whole local CI gate in one target. Nothing is
            // hand-listed — `moon ci` resolves the affected runInCI tasks
            // and runs them with its own cache.
            ["ci"] = new Step {
                check = "moon ci"
            }
        }
    }
}
