# Copied to %USERPROFILE%\.wslconfig by windows/windows-setup.ps1.
# After changing any of these, run `wsl --shutdown` for them to take effect.
#
# Hardware reference (mattpc): i9-14900KS (8P+16E = 32 logical threads),
# 64 GB DDR5, RTX 4080. Memory budget leaves 8 GB to Windows + GPU + apps.

[wsl2]
# Mirrored mode shares the Windows network stack with WSL2: Tailscale and
# DNS from the host are reachable from inside without bridging. Required
# by the nixos/mattpc-wsl/system.nix design (no Tailscale daemon inside
# the distro). Also lets Windows-side `localhost:2222` reach the WSL
# sshd, which is how Podman Desktop connects to the WSL podman engine.
networkingMode=mirrored

# DNS tunneling forwards DNS queries to the Windows resolver. Pairs with
# mirrored networking so resolution works for both the Windows host and
# the Windows resolver's tailnet entries (Technitium on the tailnet, etc.).
dnsTunneling=true

# Hyper-V Firewall: lets Windows Defender Firewall apply rules to WSL
# traffic. Default is true; explicit here for clarity. With mirrored
# networking the Windows firewall is the only gating layer (NixOS
# firewall is disabled inside WSL — see system.nix).
firewall=true

# All 32 logical CPUs available to the distro.
processors=24

# 56 GB to WSL, 8 GB reserved for Windows + GPU + background apps.
memory=56GB

[experimental]
# Auto-shrink the .vhdx after a `nix-collect-garbage` or large file
# delete. Without sparseVhd, the rootfs file grows monotonically even
# as in-WSL disk usage drops, eventually filling the Windows side.
sparseVhd=true
