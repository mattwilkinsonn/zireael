# Modifier convention: cmd+alt for yabai actions, with shift for "modify".

# --- Focus -------------------------------------------------------------------
cmd + alt - h : /opt/homebrew/bin/yabai -m window --focus west
cmd + alt - j : /opt/homebrew/bin/yabai -m window --focus south
cmd + alt - k : /opt/homebrew/bin/yabai -m window --focus north
cmd + alt - l : /opt/homebrew/bin/yabai -m window --focus east

# Cycle stacked windows (when in a stack space, or within a stacked node)
cmd + alt - n : /opt/homebrew/bin/yabai -m window --focus stack.next || /opt/homebrew/bin/yabai -m window --focus stack.first
cmd + alt - p : /opt/homebrew/bin/yabai -m window --focus stack.prev || /opt/homebrew/bin/yabai -m window --focus stack.last

# --- Move / swap -------------------------------------------------------------
shift + cmd + alt - h : /opt/homebrew/bin/yabai -m window --swap west
shift + cmd + alt - j : /opt/homebrew/bin/yabai -m window --swap south
shift + cmd + alt - k : /opt/homebrew/bin/yabai -m window --swap north
shift + cmd + alt - l : /opt/homebrew/bin/yabai -m window --swap east

# --- Stack on the fly --------------------------------------------------------
# After this, the next window opened will stack on top of the currently
# focused window instead of splitting. Use cmd+alt+n / cmd+alt+p to cycle.
cmd + alt - i : /opt/homebrew/bin/yabai -m window --insert stack

# Restore default insert (east split for next window)
cmd + alt - o : /opt/homebrew/bin/yabai -m window --insert east

# Stack the last-focused window onto the focused window (keyboard-only, no
# drag needed). Focus the source first, then focus the destination, then press.
cmd + alt - s : /opt/homebrew/bin/yabai -m window --stack recent

# Destack: pop the focused window out of its current tree node (including a
# stack) and place it east of where it was.
cmd + alt - u : /opt/homebrew/bin/yabai -m window --warp east

# Toggle mouse drop action: alt+drag onto another window will stack instead of
# swap until pressed again. Notification confirms current mode.
cmd + alt - d : \
  current=$(/opt/homebrew/bin/yabai -m config mouse_drop_action) ; \
  if [ "$current" = "swap" ]; then \
    /opt/homebrew/bin/yabai -m config mouse_drop_action stack ; \
    /opt/homebrew/bin/alerter --title "yabai drop" --message "alt+drag → stack" --timeout 5 >/dev/null ; \
  else \
    /opt/homebrew/bin/yabai -m config mouse_drop_action swap ; \
    /opt/homebrew/bin/alerter --title "yabai drop" --message "alt+drag → swap" --timeout 5 >/dev/null ; \
  fi

# --- Space layouts -----------------------------------------------------------
cmd + alt - b : /opt/homebrew/bin/yabai -m space --layout bsp
cmd + alt - e : /opt/homebrew/bin/yabai -m space --layout stack

# Re-apply AW default layout (Akiflow+Linear stacked left, Arc right).
cmd + alt - a : ~/.config/yabai/aw-layout.sh

# --- Float -------------------------------------------------------------------
# Toggle float in place — windows stays where it is, just stops tiling (and
# can re-tile by toggling again).
cmd + alt - f : /opt/homebrew/bin/yabai -m window --toggle float

# Toggle float + center on a 6×6 grid (inner 4×4) — the old behavior.
shift + cmd + alt - f : /opt/homebrew/bin/yabai -m window --toggle float --grid 6:6:1:1:4:4

# Balance to equal areas — the "all quarters" / equal-columns layout.
cmd + alt - 0 : /opt/homebrew/bin/yabai -m space --balance

# Reset all parent split ratios to 0.5 — produces the 50/25/… cascade.
# 0x18 = `=` keycode on US layout (skhd needs the keycode form for `=`).
cmd + alt - 0x18 : ~/.config/yabai/reset-splits.sh

# Force all splits vertical + balance — windows reshape into equal-width columns
# regardless of prior tree shape. Useful when the side column has stacked tall.
cmd + alt - c : ~/.config/yabai/columns.sh

# --- Move between displays ---------------------------------------------------
# Cycle through whatever displays are currently connected, wrapping at ends.
# Order = macOS Display arrangement order (G9 → AW → laptop → wrap back).
ctrl + alt - h : ~/.config/yabai/cycle-display.sh prev
ctrl + alt - l : ~/.config/yabai/cycle-display.sh next

# Explicit targets by display resolution (stable per monitor, unlike UUIDs
# which macOS sometimes regenerates on reconnect). Silent no-op if that
# display isn't currently plugged in.
ctrl + alt - 1 : ~/.config/yabai/move-to-display.sh laptop
ctrl + alt - 2 : ~/.config/yabai/move-to-display.sh g9
ctrl + alt - 3 : ~/.config/yabai/move-to-display.sh aw

# --- Resize (BSP nodes) ------------------------------------------------------
shift + cmd + alt - left  : /opt/homebrew/bin/yabai -m window --resize left:-100:0  || /opt/homebrew/bin/yabai -m window --resize right:-100:0
shift + cmd + alt - right : /opt/homebrew/bin/yabai -m window --resize right:100:0  || /opt/homebrew/bin/yabai -m window --resize left:100:0
shift + cmd + alt - up    : /opt/homebrew/bin/yabai -m window --resize top:0:-100   || /opt/homebrew/bin/yabai -m window --resize bottom:0:-100
shift + cmd + alt - down  : /opt/homebrew/bin/yabai -m window --resize bottom:0:100 || /opt/homebrew/bin/yabai -m window --resize top:0:100
