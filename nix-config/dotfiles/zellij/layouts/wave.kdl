// Wave layout — multi-agent supervision.
//
//   Left column : supervisor on top (with a stacked scratch shell behind it),
//                 jjui on the repo below.
//   Right column: 8 stacked `omp` worker agents.
//
// Launch fresh:        zellij --layout wave
// In a session:        Ctrl-t w   (or run `zwave`)
//
// The agents run `omp` directly; they inherit the env (incl. 1Password
// secrets + PATH) from the shell that launched zellij, so start zellij from a
// normal login shell. For isolated per-agent workspaces, replace a worker's
// `{ command "omp"; }` with a plain shell, then create its workspace per the
// per-agent layout — `mkdir -p ~/agents/workspaces/<slot>-<codename> &&
// jj workspace add --name <slot>-<codename>
// ~/agents/workspaces/<slot>-<codename>/<repo> -r 'trunk()'` — and `cd` into it
// before running `omp` (see skill://multi-agent-wave → Workspace layout).
layout {
    tab name="wave" focus=true {
        pane split_direction="vertical" {
            // LEFT column
            pane split_direction="horizontal" size="38%" {
                // supervisor + a scratch shell, stacked (expand the shell when needed)
                pane stacked=true {
                    pane name="supervisor" focus=true
                    pane name="shell"
                }
                pane name="jjui" {
                    command "jjui"
                }
            }
            // RIGHT column: 8 omp worker agents, stacked
            pane stacked=true {
                pane name="agent 1" { command "omp"; }
                pane name="agent 2" { command "omp"; }
                pane name="agent 3" { command "omp"; }
                pane name="agent 4" { command "omp"; }
                pane name="agent 5" { command "omp"; }
                pane name="agent 6" { command "omp"; }
                pane name="agent 7" { command "omp"; }
                pane name="agent 8" { command "omp"; }
            }
        }
    }
}