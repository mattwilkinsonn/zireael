// Push layout — review + push bookmarks across repos.
//
//   Left : jjui (check the log / select bookmarks to push).
//   Right: 4 plain shells, tiled top-to-bottom (NOT stacked) — one per repo or
//          for parallel `jj git push` / status checks.
//
// Launch fresh:   zellij --layout push
// In a session:   Ctrl-t p   (or run `zpush`)
layout {
    tab name="push" focus=true {
        pane split_direction="vertical" {
            pane name="jjui" size="40%" {
                command "jjui"
            }
            pane split_direction="horizontal" {
                pane name="shell 1" focus=true
                pane name="shell 2"
                pane name="shell 3"
                pane name="shell 4"
            }
        }
    }
}