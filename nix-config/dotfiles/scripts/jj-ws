set -euo pipefail

# jj-ws — thin convenience around `jj workspace` for the multi-agent
# wave. Workspaces are created as siblings of the repo in a `<repo>.ws/`
# directory so they stay out of the main checkout. Run inside any jj
# repo (most repos here are colocated jj+git).
#
#   jj-ws add <name>   create + print path of a new workspace
#   jj-ws rm  <name>   forget the workspace and delete its directory
#   jj-ws ls           list workspaces (alias: list)
#
# Pair with the `wave` zellij layout: open a worker pane, `cd "$(jj-ws
# add slot1)"`, then `omp`. Forget with `jj-ws rm slot1` when done.

usage() {
  echo "usage: jj-ws {add|rm|ls} [name]" >&2
  exit 2
}

# A workspace name must be a plain identifier. Reject empty, `.`/`..`, slashes,
# and any `..` so the `rm -rf "$wsdir/$name"` below can't be tricked into
# escaping <repo>.ws/ (e.g. `jj-ws rm ../sibling`, `jj-ws rm .`).
require_name() {
  name="${1:?$(usage)}"
  case "$name" in
    . | .. | */* | *..*)
      echo "jj-ws: invalid workspace name: '$name'" >&2
      exit 2
      ;;
  esac
}

cmd="${1:-ls}"
[ "$#" -gt 0 ] && shift || true

root="$(jj workspace root 2>/dev/null)" || {
  echo "jj-ws: not inside a jj repo" >&2
  exit 1
}
# Anchor the .ws dir to the MAIN repo, not the current workspace, so add/rm
# work even when run from inside a worker workspace (the wave case): from
# `<repo>.ws/<slot>` this strips back to `<repo>`; from the main repo it is a
# no-op. (jj-ws always creates workspaces at `<repo>.ws/<name>`.)
mainroot="${root%.ws/*}"
wsdir="${mainroot%/}.ws"

case "$cmd" in
  add)
    require_name "${1:-}"
    mkdir -p "$wsdir"
    jj workspace add --name "$name" "$wsdir/$name" >&2
    printf '%s\n' "$wsdir/$name"
    ;;
  rm | forget)
    require_name "${1:-}"
    target="${wsdir:?}/${name:?}"
    # Only operate on jj-ws-managed workspaces — they always live at
    # <repo>.ws/<name>. A missing target dir means a typo or the repo's MAIN
    # workspace (e.g. `default`, whose checkout is <repo>, not under .ws);
    # `jj workspace forget` would happily unregister it, so refuse here.
    if [ ! -d "$target" ]; then
      echo "jj-ws: no jj-ws workspace at $target (refusing '$name')" >&2
      exit 1
    fi
    # refuse to delete the workspace you're standing in (resolve symlinks so
    # macOS /var vs /private/var doesn't defeat the check)
    here="$(pwd -P)"
    canon="$(cd "$target" 2>/dev/null && pwd -P || printf '%s' "$target")"
    case "$here/" in
      "$canon/"*)
        echo "jj-ws: cd out of '$name' before removing it" >&2
        exit 1
        ;;
    esac
    # Forget the workspace metadata FIRST; only delete the directory if that
    # succeeded. A suppressed forget failure (locked repo, inconsistent state,
    # already-forgotten name) would otherwise leave jj with a registered
    # workspace whose checkout is gone — a dead `jj workspace list` entry that
    # blocks re-adding the name.
    if ! jj workspace forget "$name"; then
      echo "jj-ws: 'jj workspace forget $name' failed — leaving $target in place" >&2
      exit 1
    fi
    rm -rf "$target"
    echo "jj-ws: removed workspace '$name' ($target)" >&2
    ;;
  ls | list)
    jj workspace list
    ;;
  *)
    usage
    ;;
esac
