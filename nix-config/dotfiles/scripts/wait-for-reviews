# wait-for-reviews <pr> [owner/repo] — block until the PR's review bots have
# reviewed the current head (or are rate/usage-limited, or reviewed an earlier
# commit and didn't re-trigger within a grace window, or a backstop elapses),
# so an agent can push → wait → triage in one autonomous loop.
#
# Run async from the agent (bash async:true, generous timeout): when it returns,
# the agent wakes and triages. No webhook needed.
#
# Per-bot state each poll:
#   done    — reviewed the CURRENT head (commit_id == head, or summary names it)
#   limited — rate/usage-limited (don't block on it)
#   stale   — reviewed an EARLIER commit but not the head
#   pending — no review from this bot yet
# Re-review signals (empirical, from real sealed PRs):
#   cubic      (cubic-dev-ai)             review.commit_id == head
#   greptile   (greptile-apps)            review.commit_id == head, or its summary
#                                         comment names the head SHA
#   codex      (chatgpt-codex-connector)  review.commit_id == head ; the 👍 reaction
#                                         is NOT trusted ; ignore on "usage limits"
#   coderabbit (coderabbitai)             EDITS its summary comment in place (key on
#                                         the body naming head) ; ignore on "rate limited"
#
# Why "stale": most bots re-review on every push (Greptile, CodeRabbit) and reach
# "done" within the grace, but some only re-review on a smart/manual trigger
# (Codex) and there is no signal for whether a given push will re-trigger them.
# So a `stale` bot blocks only until WAIT_GRACE_SECS, then counts as done-stale
# (reported, not blocked) — we wait briefly for a maybe-re-review, then proceed
# rather than stranding the loop at the backstop. A `pending` bot (no review at
# all) blocks until the backstop, since it may simply be slow on a first pass —
# scope WAIT_BOTS to the bots that actually review the repo.
#
# Env: WAIT_BOTS (space list), WAIT_BACKSTOP_SECS (1200), WAIT_GRACE_SECS (300),
#      WAIT_POLL_SECS (30).
# shellcheck shell=bash
set -euo pipefail
PR="${1:?usage: wait-for-reviews <pr> [owner/repo]   (env: WAIT_BOTS WAIT_GRACE_SECS WAIT_BACKSTOP_SECS WAIT_POLL_SECS)}"
REPO="${2:-$(gh repo view --json nameWithOwner -q .nameWithOwner)}"
BOTS="${WAIT_BOTS:-coderabbitai cubic-dev-ai greptile-apps chatgpt-codex-connector}"
BACKSTOP="${WAIT_BACKSTOP_SECS:-1200}"
GRACE="${WAIT_GRACE_SECS:-300}"
INTERVAL="${WAIT_POLL_SECS:-30}"

# ─── tern-first review-state fetch ───────────────────────────────────────
# Every fleet agent polls its own PR here. To avoid N agents × M polls hammering
# the shared GitHub API bucket, ALWAYS read through tern (the caching review MCP,
# SEA-1083) via the LiteLLM gateway: N reads of a PR collapse to one batched
# upstream fetch + cache hits. tern returns head + reviews + comments + threads
# + check-runs in one call. Fall back to gh-route (bucket-balanced REST/GraphQL)
# only if the gateway env is absent or tern is unreachable.
#
# tern_state → prints tern's full review-state JSON on stdout, or "" on failure.
TERN_MCP_URL="${LITELLM_MCP_URL:-}"
TERN_MCP_KEY="${LITELLM_API_KEY:-}"
tern_state() {
  [ -n "$TERN_MCP_URL" ] && [ -n "$TERN_MCP_KEY" ] || return 1
  local owner="${REPO%%/*}" name="${REPO##*/}" payload resp
  payload=$(jq -nc --arg o "$owner" --arg n "$name" --argjson p "$PR" \
    '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:"get_review_state",arguments:{owner:$o,repo:$n,number:$p}}}')
  resp=$(curl -sS -m 25 -X POST "$TERN_MCP_URL" \
    -H "x-litellm-api-key: Bearer $TERN_MCP_KEY" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -H "x-mcp-servers: tern" \
    -d "$payload" 2>/dev/null) || return 1
  # SSE frames: the JSON-RPC result is the `data:` line; unwrap the tool text.
  sed -n 's/^data: //p' <<<"$resp" \
    | jq -e -r '.result.content[0].text' 2>/dev/null
}

# head SHA: prefer tern's cached state (no upstream call for the fleet); else the
# adaptive router. Fetch state once up front so the classifier has a head to key on.
state="$(tern_state || true)"
head=""
[ -n "$state" ] && head="$(jq -r '.head_sha // ""' <<<"$state")"
# tern up but head_sha missing/empty → treat as a miss and resolve via the router,
# never leave $head empty (an empty head makes the classifier's grep match every
# line and misreport every bot as "done").
if [ -z "$head" ]; then
  head="$(gh-route head-sha "$PR" "$REPO")"
  state=""
fi
echo "wait-for-reviews: $REPO#$PR head=${head:0:10} bots=[$BOTS] grace=${GRACE}s backstop=${BACKSTOP}s (tern:$([ -n "$state" ] && echo on || echo off))"
start=$(date +%s)

# classify <bot> <reviews-json> <comments-json> → done | limited | stale | pending
classify() {
  local bot="$1" reviews="$2" comments="$3" rev_head rev_any cbody
  rev_head=$(jq -r --arg b "$bot" --arg h "$head" \
    '[.[] | select((.user.login|ascii_downcase|sub("\\[bot\\]";""))==$b) | select(.commit_id==$h)] | length' \
    <<<"$reviews" 2>/dev/null || echo 0)
  rev_any=$(jq -r --arg b "$bot" \
    '[.[] | select((.user.login|ascii_downcase|sub("\\[bot\\]";""))==$b)] | length' \
    <<<"$reviews" 2>/dev/null || echo 0)
  cbody=$(jq -r --arg b "$bot" \
    '[.[] | select((.user.login|ascii_downcase|sub("\\[bot\\]";""))==$b)] | sort_by(.updated_at) | last | .body // ""' \
    <<<"$comments" 2>/dev/null || echo "")
  case "$bot" in
    coderabbitai)
      grep -qi "rate limited by coderabbit.ai" <<<"$cbody" && { echo "limited"; return; }
      grep -qE "$head|${head:0:7}" <<<"$cbody" && { echo "done"; return; }
      [ -n "$cbody" ] && { echo "stale"; return; } ;;
    chatgpt-codex-connector)
      grep -qi "usage limits for code reviews" <<<"$cbody" && { echo "limited"; return; }
      [ "${rev_head:-0}" -gt 0 ] && { echo "done"; return; }
      [ "${rev_any:-0}" -gt 0 ] && { echo "stale"; return; } ;;
    greptile-apps)
      [ "${rev_head:-0}" -gt 0 ] && { echo "done"; return; }
      grep -qE "$head|${head:0:7}" <<<"$cbody" && { echo "done"; return; }
      { [ "${rev_any:-0}" -gt 0 ] || [ -n "$cbody" ]; } && { echo "stale"; return; } ;;
    *)
      [ "${rev_head:-0}" -gt 0 ] && { echo "done"; return; }
      [ "${rev_any:-0}" -gt 0 ] && { echo "stale"; return; } ;;
  esac
  echo "pending"
}

# Seed the first iteration with the state already fetched for the head SHA, so
# the opening cycle is one tern call, not two. Cleared at each loop end to force
# a fresh read next poll.
st_json="$state"
while :; do
  # One tern read per poll gives reviews + comments (cache-served, fleet-shared);
  # fall back to gh-route's REST reads only if tern is unavailable this cycle.
  [ -n "$st_json" ] || st_json="$(tern_state || true)"
  if [ -n "$st_json" ]; then
    reviews="$(jq -c '.reviews // []' <<<"$st_json" 2>/dev/null || echo '[]')"
    comments="$(jq -c '.comments // []' <<<"$st_json" 2>/dev/null || echo '[]')"
  else
    reviews="$(gh-route reviews "$PR" "$REPO" 2>/dev/null || echo '[]')"
    comments="$(gh-route comments "$PR" "$REPO" 2>/dev/null || echo '[]')"
  fi
  now=$(date +%s)
  elapsed=$((now - start))
  blocking=()
  for bot in $BOTS; do
    st=$(classify "$bot" "$reviews" "$comments")
    # A stale bot blocks only until the grace window passes: re-review-on-push
    # bots usually reach "done" within it; smart/manual-trigger bots don't, and
    # there's no signal to tell in advance — so wait briefly, then proceed.
    [ "$st" = stale ] && [ "$elapsed" -lt "$GRACE" ] && st="stale(waiting)"
    printf '  %-26s %s\n' "$bot" "$st"
    case "$st" in
      pending | "stale(waiting)") blocking+=("$bot") ;;
    esac
  done
  if [ "${#blocking[@]}" -eq 0 ]; then
    echo "wait-for-reviews: reviews ready (done / limited / stale)"
    exit 0
  fi
  if [ "$elapsed" -ge "$BACKSTOP" ]; then
    echo "wait-for-reviews: backstop ${BACKSTOP}s reached; proceeding. still blocking: ${blocking[*]}"
    exit 0
  fi
  st_json="" # force a fresh tern read on the next poll
  sleep "$INTERVAL"
done
