export PATH="$HOME/.local/bin:$PATH"

# Directory navigation
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS

# CLI completions, cached via _evalcache (defined in .zshenv). The generators
# are slow Node/clap subprocesses run on every shell; the registration script
# they emit is static per tool version, while live TAB-completion still
# re-invokes the tool (e.g. gt's yargs / jj's clap dynamic completer). So
# caching the script keeps completions dynamic but drops the startup cost.
# _evalcache no-ops when a tool is absent (replaces the old `command -v` guards)
# and regenerates when the binary's path/mtime changes.
_evalcache jj    jj    env COMPLETE=zsh jj
_evalcache jj-hp jj-hp jj-hp completions zsh
_evalcache jj-gt jj-gt jj-gt completions zsh
_evalcache gt    gt    gt completion zsh

# Tool shell-inits, cached via _evalcache (see .zshenv). These replace the
# home-manager enableZshIntegration evals (disabled in shared/home.nix); each
# is a per-shell subprocess otherwise. Guards mirror the home-manager originals.
_evalcache zoxide zoxide zoxide init zsh
_evalcache direnv direnv direnv hook zsh
[[ $options[zle] = on ]] && _evalcache fzf fzf fzf --zsh
[[ $TERM != dumb ]] && _evalcache starship starship starship init zsh
