#!/usr/bin/env bash
# Scripting addition (required for sudo-gated yabai features like focus follows)
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# Layout defaults
yabai -m config layout                      bsp
yabai -m config split_ratio                 0.5
yabai -m config split_type                  auto
yabai -m config auto_balance                off
yabai -m config window_placement            second_child
yabai -m config window_animation_duration   0.0
yabai -m config mouse_follows_focus         off
yabai -m config focus_follows_mouse         off

# Mouse: hold the modifier and drag any part of a window to move/resize.
# Default drop = swap; toggle to stack via skhd (cmd+alt+d).
yabai -m config mouse_modifier              alt
yabai -m config mouse_action1               move
yabai -m config mouse_action2               resize
yabai -m config mouse_drop_action           swap

# No gaps — windows butt edge to edge
yabai -m config top_padding    0
yabai -m config bottom_padding 0
yabai -m config left_padding   0
yabai -m config right_padding  0
yabai -m config window_gap     0

# Per-display layout (laptop → stack on space 1) + per-app routing rules.
# Both scripts resolve display/space indexes dynamically by resolution at
# runtime, so they keep working when macOS reorders things on connect.
DISPLAY_SETUP="$HOME/.config/yabai/display-setup.sh"
RULES="$HOME/.config/yabai/rules.sh"
AW_LAYOUT="$HOME/.config/yabai/aw-layout.sh"

"$DISPLAY_SETUP"
"$RULES"
"$AW_LAYOUT"

yabai -m signal --add event=display_added   action="$DISPLAY_SETUP && $RULES && $AW_LAYOUT"
yabai -m signal --add event=display_removed action="$DISPLAY_SETUP && $RULES && $AW_LAYOUT"
yabai -m signal --add event=display_moved   action="$DISPLAY_SETUP && $RULES && $AW_LAYOUT"

# Ghostty uses native macOS tabs, which yabai sees as separate windows.
# Reassert bsp when tabs are created/destroyed so the space does not drift.
yabai -m signal --add app="^Ghostty$" event=window_created action="yabai -m space --layout bsp"
yabai -m signal --add app="^Ghostty$" event=window_destroyed action="yabai -m space --layout bsp"

# AW default layout: re-apply when one of the target apps launches or a new
# window for it appears (script is idempotent + locked so this is cheap).
yabai -m signal --add event=application_launched \
  action="case \"\$YABAI_PROCESS_NAME\" in Akiflow|Linear|Arc) \"$AW_LAYOUT\" ;; esac"
yabai -m signal --add event=window_created \
  action="case \"\$YABAI_PROCESS_NAME\" in Akiflow|Linear|Arc) \"$AW_LAYOUT\" ;; esac"
