#!/usr/bin/env bash
# direnv hook for zireael. Loaded by `direnv allow` (one-time).
#
# Adds cargo + bun + cargo-binstall to PATH so `just ci` works in a
# fresh shell. PATH_add is direnv's idempotent prepend.

PATH_add "$HOME/.cargo/bin"
PATH_add "$HOME/.bun/bin"

# When XDG_BIN_HOME is set (CI uses this), prepend it too so tools
# installed by `just install-deps` land on PATH.
if [ -n "${XDG_BIN_HOME:-}" ]; then
    PATH_add "$XDG_BIN_HOME"
fi
